<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- jdbc/matriculasDS: JNDI propio, distinto de jdbc/__default (que ya usa
         HelloJakarta-variante), porque cada WAR necesita su propio pool/recurso en
         GlassFish para no mezclar esquemas en una sola base. Ver el resumen final para los
         comandos asadmin que crean este pool (H2 embebida, mismo patron que
         HelloJakarta-variante, ver Documentation/h2.md de ese proyecto). -->
    <persistence-unit name="SistemaMatriculasPU" transaction-type="JTA">
        <jta-data-source>jdbc/matriculasDS</jta-data-source>
        <properties>
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.H2Platform"/>
            <property name="eclipselink.logging.level" value="FINE"/>
        </properties>
    </persistence-unit>

</persistence>
